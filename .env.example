# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=db_dogschool
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-local-password

# Segurança das sessões
SESSION_SECRET=substitua-por-um-segredo-aleatorio-longo

# Proteção de CPF e e-mail
# AES-256-GCM: chave aleatória de 32 bytes em Base64
DATA_ENCRYPTION_KEY=

# HMAC-SHA-256: chave diferente, também de 32 bytes em Base64
DATA_LOOKUP_KEY=

# Frontend
FRONTEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:8080
COOKIE_SECURE=false

# Recuperação de senha
EMAIL_PROVIDER=mailpit
PUBLIC_BASE_URL=http://localhost:8080

# Produção com Resend
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=DogSchool <nao-responda@seudominio.com>